# ============================================================
# FLAIR API
# Obtain credentials from Flair > Account Settings > Developer Settings.
# Store actual credentials only in .env, never in .env.example.
# ============================================================

# OAuth Client ID for accessing Flair devices
FLAIR_CLIENT_ID=
# OAuth Client Secret (keep private)
FLAIR_CLIENT_SECRET=


# ============================================================
# LOCATION AND TIMEZONE
# ============================================================

# Location for outdoor weather via Open-Meteo
WEATHER_LOCATION="Indianapolis, IN"
# Timezone for scheduling, including daylight saving time
CLIMATE_TIMEZONE=America/Indiana/Indianapolis


# ============================================================
# OPERATING SCHEDULE
# Times use 24-hour local time. Overnight schedules are supported.
# Outside these hours, the controller requests fan OFF.
# ============================================================

# Fan automation enabled starting at time
CLIMATE_SCHEDULE_START=22:00
# Fan automation disabled starting at time
CLIMATE_SCHEDULE_END=07:30


# ============================================================
# TEMPERATURE CONTROL (FAHRENHEIT)
# Uses the bedroom temperature reported by the Flair Puck.
# ============================================================

# Stop cooling when bedroom reaches N°F or falls below
CLIMATE_TARGET_F=58
# Restart cooling when bedroom reaches N°F if fan is off
CLIMATE_RESTART_F=62
# Outdoor air must be at least N°F cooler than bedroom
CLIMATE_MIN_COOLING_ADVANTAGE_F=5


# ============================================================
# FAN SPEED CONTROL
# Speeds range from 1 (quietest) to 4 (fastest).
# Thresholds refer to BEDROOM temperature, not outdoor temp.
# Speed 1 is the default whenever cooling is needed.
# ============================================================

# Select speed 2 when bedroom is sufficiently warm
CLIMATE_SPEED_2_AT_F=64
# Select speed 3 at higher bedroom temperatures
CLIMATE_SPEED_3_AT_F=68
# Select speed 4 at very high bedroom temperatures
CLIMATE_SPEED_4_AT_F=72

# Temperature buffer to prevent frequent speed changes
CLIMATE_SPEED_HYSTERESIS_F=0.5


# ============================================================
# LOCAL DEVICE NETWORK (OPTIONAL UNTIL HARDWARE ARRIVES)
# These are LAN hosts, not full URLs. No commands are sent by
# the main controller; hardware probes must be explicitly invoked.
# ============================================================

# BroadLink RM4 Pro Wi-Fi IP address or .local hostname
BROADLINK_HOST=
# Shelly Plug US Gen4 Wi-Fi IP address or .local hostname
SHELLY_HOST=
# Optional Shelly local-RPC password if device authentication is enabled
SHELLY_PASSWORD=
# Optional Shelly RPC account name (typically admin)
SHELLY_USERNAME=admin
# Local path to your learned IR/RF codes; excluded from Git
BROADLINK_CODES_FILE=data/remote_codes.json
