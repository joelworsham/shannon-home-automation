# ============================================================
# FLAIR API
# Obtain credentials from Flair > Account Settings > Developer Settings.
# Store actual credentials only in .env, never in .env.example.
# ============================================================

# OAuth Client ID for accessing Flair devices
FLAIR_CLIENT_ID=
# OAuth Client Secret (keep private)
FLAIR_CLIENT_SECRET=


# ============================================================
# LOCATION AND TIMEZONE
# ============================================================

# Location for outdoor weather via Open-Meteo
WEATHER_LOCATION="Indianapolis, IN"
# Timezone for scheduling, including daylight saving time
CLIMATE_TIMEZONE=America/Indiana/Indianapolis


# ============================================================
# OPERATING SCHEDULE
# Times use 24-hour local time. Overnight schedules are supported.
# Legacy single-window mode requests OFF outside these hours.
# Optional daily time blocks: copy config/schedule.example.json to
# data/schedule.json, edit the blocks, then set CLIMATE_SCHEDULE_FILE.
# With a schedule file, blocks replace the legacy window/temperature settings.
# Gaps shut down once on leaving a block, then allow manual operation.
# Empty list [] means always inactive. Blank keeps legacy behavior.
# Relative paths are resolved from this project directory.
CLIMATE_SCHEDULE_FILE=
# ============================================================

# Fan automation enabled starting at time
CLIMATE_SCHEDULE_START=22:00
# Fan automation disabled starting at time
CLIMATE_SCHEDULE_END=07:30


# ============================================================
# TEMPERATURE CONTROL (FAHRENHEIT)
# Uses the bedroom temperature reported by the Flair Puck.
# ============================================================

# Stop cooling when bedroom reaches N°F or falls below
CLIMATE_TARGET_F=60
# Restart cooling when bedroom reaches N°F if fan is off
CLIMATE_RESTART_F=64
# Outdoor air must be at least N°F cooler than bedroom
CLIMATE_MIN_COOLING_ADVANTAGE_F=5


# ============================================================
# FAN SPEED CONTROL
# Low = physical speed 1; high = physical speed 4. Intermediate speeds are unused.
# Optional bedroom temperature threshold for high; blank means always use low.
# Set to the cooling target for high whenever cooling is active.
# At or below the cooling target, the fan is OFF.
CLIMATE_HIGH_AT_F=68

# Temperature buffer to prevent frequent speed changes
CLIMATE_SPEED_HYSTERESIS_F=0.5


# ============================================================
# LOCAL DEVICE NETWORK (OPTIONAL UNTIL HARDWARE ARRIVES)
# These are LAN hosts, not full URLs. No commands are sent by
# the main controller; hardware probes must be explicitly invoked.
# ============================================================

# BroadLink RM4 Pro Wi-Fi IP address or .local hostname
BROADLINK_HOST=
# Shelly Plug US Gen4 Wi-Fi IP address or .local hostname
SHELLY_HOST=
# Optional Shelly local-RPC password if device authentication is enabled
SHELLY_PASSWORD=
# Optional Shelly RPC account name (typically admin)
SHELLY_USERNAME=admin
# Local path to your learned IR/RF codes; excluded from Git
BROADLINK_CODES_FILE=data/remote_codes.json

# Guarded delivery opt-in; controller.py ALSO requires --live --exclusive-control.
HARDWARE_CONTROL_ENABLED=false
# Separate unattended opt-in; requires commissioning and --unattended.
# Reserve the fan for automation; pause before using its app/original remote.
UNATTENDED_CONTROL_ENABLED=false
# User-reported display sleep/reset interval; not a measured guarantee.
FAN_DISPLAY_SLEEP_S=6
# Delay after an acknowledged wake packet before the intended action.
FAN_WAKE_DELAY_S=1
# Conservative timing allowance around the display awake window.
FAN_TIMING_MARGIN_S=0.25
# Maximum age of verified power evidence used by guarded delivery.
HARDWARE_OBSERVATION_MAX_AGE_S=10
# Calibrated standby ceiling in watts. REQUIRED for live use; no assumed default.
FAN_STANDBY_MAX_W=
# Calibrated running floor in watts, above standby ceiling. Gap stays unknown.
FAN_RUNNING_MIN_W=
# Seconds between readings while filling a power classification window.
FAN_POWER_SAMPLE_INTERVAL_S=1
# Minimum consistent window; at least two sample intervals (three readings).
FAN_POWER_WINDOW_S=2
# Wait after a command before collecting fresh post-action samples.
FAN_POWER_SETTLE_S=6
# Expiry of per-invocation physical speed/direction attestations, in seconds.
FAN_MANUAL_EVIDENCE_MAX_AGE_S=30

# Background collection interval in seconds (default: 300 = five minutes).
# After changing, apply with ./setup.sh --install-launchd.
COLLECTOR_INTERVAL_SECONDS=300
